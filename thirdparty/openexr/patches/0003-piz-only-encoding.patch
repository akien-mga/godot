-
-        //
-        // K0, K1 are active until after dst[1],dst[7]
-        //  as well as dst[3], dst[5] are computed.
-        //
-
-        K0 = c4 * (A1 - A5);
-        K1 = -1 * c4 * (A2 + A6);
-
-        //
-        // (2*dst3, 2*dst5) = rot -3 ( d07 - K0,  d34 + K1 )
-        //
-
-        rot_x = A7 - K0;
-        rot_y = A4 + K1;
