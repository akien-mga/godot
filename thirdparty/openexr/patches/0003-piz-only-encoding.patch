-static inline int
-shiftAndRound (int x, int shift)
-{
-    int a, b;
-    //
-    // Compute
-    //
-    //     y = x * pow (2, -shift),
-    //
-    // then round y to the nearest integer.
-    // In case of a tie, where y is exactly
-    // halfway between two integers, round
-    // to the even one.
-    //
-
-    x <<= 1;
-    a = (1 << shift) - 1;
-    shift += 1;
-    b = (x >> shift) & 1;
-    return (x + a + b) >> shift;
-}
