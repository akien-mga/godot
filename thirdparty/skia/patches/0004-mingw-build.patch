@@ -49,7 +49,15 @@
  * `B` is the (1 based) index of the first argument used by the format string.
  */
 #if !defined(SK_PRINTF_LIKE)
-#  define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(printf, (A), (B)))
+// -- GODOT start --
+// MinGW defaults the `printf` format archetype to the msvcrt one, which rejects
+// the C99 length modifiers (e.g. `%zu`) that Skia uses.
+#  if defined(__MINGW32__)
+#    define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(gnu_printf, (A), (B)))
+#  else
+#    define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(printf, (A), (B)))
+#  endif
+// -- GODOT end --
 #endif
 
