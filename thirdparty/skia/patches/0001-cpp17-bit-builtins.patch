+// -- GODOT start --
+// Godot is built with C++17, which doesn't have <bit> and its bit manipulation
+// helpers yet. Fall back to the compiler builtins where they exist, and to a
+// portable implementation for MSVC, whose _BitScan* intrinsics can't be used in
+// a constant expression.
+#if __cplusplus >= 202002L
+#include <bit>
+#endif
+// -- GODOT end --
 
 /**
  * Return the number of leading zero bits.
  */
 static constexpr int SkCLZ(uint32_t x) {
+// -- GODOT start --
+#if __cplusplus >= 202002L
     return std::countl_zero<uint32_t>(x);
+#elif defined(__GNUC__) || defined(__clang__)
+    return x ? __builtin_clz(x) : 32;
+#else
+    if (x == 0) {
+        return 32;
+    }
+    int n = 0;
+    if ((x & 0xFFFF0000) == 0) { n += 16; x <<= 16; }
+    if ((x & 0xFF000000) == 0) { n +=  8; x <<=  8; }
+    if ((x & 0xF0000000) == 0) { n +=  4; x <<=  4; }
+    if ((x & 0xC0000000) == 0) { n +=  2; x <<=  2; }
+    if ((x & 0x80000000) == 0) { n +=  1; }
+    return n;
+#endif
+// -- GODOT end --
 }
 
 /**
  * Return the number of trailing zero bits.
  */
 static constexpr int SkCTZ(uint32_t x) {
+// -- GODOT start --
+#if __cplusplus >= 202002L
     return std::countr_zero<uint32_t>(x);
+#elif defined(__GNUC__) || defined(__clang__)
+    return x ? __builtin_ctz(x) : 32;
+#else
+    if (x == 0) {
+        return 32;
+    }
+    int n = 0;
+    if ((x & 0x0000FFFF) == 0) { n += 16; x >>= 16; }
+    if ((x & 0x000000FF) == 0) { n +=  8; x >>=  8; }
+    if ((x & 0x0000000F) == 0) { n +=  4; x >>=  4; }
+    if ((x & 0x00000003) == 0) { n +=  2; x >>=  2; }
+    if ((x & 0x00000001) == 0) { n +=  1; }
+    return n;
+#endif
+// -- GODOT end --
 }
 
 /*
  * Return the number of set bits (i.e., the population count) in the provided uint32_t.
  */
 static constexpr int SkPopCount(uint32_t x) {
+// -- GODOT start --
+#if __cplusplus >= 202002L
     return std::popcount<uint32_t>(x);
+#elif defined(__GNUC__) || defined(__clang__)
+    return __builtin_popcount(x);
+#else
+    x = x - ((x >> 1) & 0x55555555);
+    x = (x & 0x33333333) + ((x >> 2) & 0x33333333);
+    x = (x + (x >> 4)) & 0x0F0F0F0F;
+    return static_cast<int>((x * 0x01010101) >> 24);
+#endif
+// -- GODOT end --
 }
 
